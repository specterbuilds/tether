{
  "name": "@tether/core",
  "version": "0.1.0",
  "description": "Core manifest model, content hashing and perceptual fingerprinting for Tether",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/specterbuilds/tether.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/specterbuilds/tether#readme",
  "bugs": {
    "url": "https://github.com/specterbuilds/tether/issues"
  },
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "photo-provenance",
    "c2pa",
    "content-credentials",
    "provenance",
    "image-verification"
